{
    "name": "linked",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "clear": "rmdir /s /q .next",
        "dev:clear": "npm run clear & npm run dev",
        "refresh": "rmdir /s /q .next & rmdir /s /q node_modules & npm install",
        "dev:refresh": "npm run refresh & npm run dev",
        "generate": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
        "test:chrome": "npx playwright test --headed --browser=chromium",
        "test:firefox": "npx playwright test --headed --browser=firefox",
        "test:safari": "npx playwright test --headed --browser=webkit"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "better-auth": "^1.6.2",
        "gsap": "^3.14.2",
        "next": "16.2.2",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-icons": "^5.6.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.2",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
